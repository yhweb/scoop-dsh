{
    "##": "Windows x64/arm64 only. Upstream ships an electron-builder NSIS installer (oneClick, no portable zip); this manifest extracts the embedded app-*.7z payload out of $PLUGINSDIR instead of running the installer, so nothing is written outside the scoop app dir and no admin rights are needed.",
    "version": "2.7.1",
    "description": "OpenChamber —— 面向 AI 编程的智能体开发环境（Agentic Development Environment，基于 OpenCode 的桌面端）",
    "homepage": "https://openchamber.dev",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/openchamber/openchamber/blob/main/LICENSE"
    },
    "notes": [
        "上游只发 electron-builder 的 NSIS 安装器，本 manifest 直接抽出内嵌的 app-*.7z 载荷解包，不跑安装器、不写注册表、不需要管理员权限",
        "配置与数据由程序自己保存在用户目录，Scoop 不接管，升级与卸载都不会动它",
        "请在应用内关掉自带自动更新，改用 scoop update openchamber"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v2.7.1/OpenChamber-2.7.1-win-x64.exe#/dl.7z",
            "hash": "sha512:fdc41c738a3a5d1e3c3749d2a98ba4f09f71ddaafcca70129d688c55a751306883d0d5097f09cde7f3e69e0af58ab0fa6f9d435e15121025482fe4328bcc5c7e"
        },
        "arm64": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v2.7.1/OpenChamber-2.7.1-win-arm64.exe#/dl.7z",
            "hash": "sha512:dac75282faad533f8b515b491d17c752a43b6c123e228faf7bbfffdc9237347e46dd400d1ae67415e1970c7ef78f8eb9438dac2f3eca35a6ec0f5b5e47a91209"
        }
    },
    "installer": {
        "script": [
            "Get-Item \"$dir\\`$PLUGINSDIR\\app-*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\" -Removal",
            "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "OpenChamber.exe",
            "OpenChamber"
        ]
    ],
    "checkver": {
        "url": "https://github.com/openchamber/openchamber/releases.atom",
        "regex": "releases/tag/v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest-arm64.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
